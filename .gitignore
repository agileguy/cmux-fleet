node_modules
.worktrees/
dist/
*.log
.DS_Store
.pifleet/
run-*/
coverage/
fleet.yaml

# The mount probe's sentinel (MOUNT_PROBE_SENTINEL). `doctor` now probes the
# CHECKOUT as well as the runs and scratch roots, because the relay bind-mounts
# three scripts out of it, and `probeMountVisibility` writes this file into the
# directory it is measuring and removes it in a `finally`. Interrupt the command
# between those two and the file survives — untracked, in the operator's own
# working tree. Ignored so a stray one can never become a commit.
.pifleet-mount-probe

# Federated credential written by google-github-actions/auth. The container
# job moves it out of the workspace and fails if any remain, but a stray file
# must never become a commit.
gha-creds-*.json

# Agent worktrees — transient, created by background agents
.claude/worktrees/

# Local console fleets. `fleet.yaml` is already ignored for this reason; these
# are the same thing under a name `--config` can point at, and they name the
# operator's own hosts, endpoints and egress allowances. `fleet.example.yaml`
# is the tracked, annotated one.
fleet-development.yaml
fleet-operations-local.yaml
