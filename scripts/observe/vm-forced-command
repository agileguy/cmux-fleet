#!/bin/sh
# vm-forced-command — the whole of what the observer-vm credential can do
# (SRD-OBSERVER-ROLES §6.2-6.4; Phase 5 task 5.1 landed `uptime`, `os`,
# `system`, `failed`, `unit`, `disk` and `memory`; task 5.3 adds `journal`
# and `kernel`).
#
# Installed root-owned, mode 0755, at a path the enrolled account cannot
# write, and named as the `command=` in that account's one `authorized_keys`
# line (§6.2, following §5.7's pattern): `restrict,command="<installed path>"
# ssh-ed25519 <key> pifleet-observer-vm`. sshd then runs THIS SCRIPT for
# every session that key opens, with NO arguments of its own — whatever the
# client asked for arrives only in SSH_ORIGINAL_COMMAND, which OpenSSH sets
# to the client's argv joined with a single ASCII space between each element
# (`docker/observe-ssh` sends `-- "<verb>" "$@"`, so the string here is
# `<verb> [argument ...]`).
#
# ## Who owns what
#
# `docker/observe-ssh` owns ARGV SAFETY on the WORKER side and is a
# courtesy: a worker that skips it and drives ssh directly can put anything
# at all into SSH_ORIGINAL_COMMAND, including bytes no shell word ever holds
# (an embedded newline, a leading '-', a NUL is impossible over the wire but
# nothing else is). THIS script is the credential's only enforcement, on the
# target, of a rule the worker cannot step around, and it is written to that
# threat model: every character class below is spelled out, nothing is ever
# `eval`ed, and no refusal message repeats back an attacker-controlled byte
# that has not first passed one of those classes (an unvalidated verb or
# argument might carry a newline that would forge a second, fake log line).
# It follows `scripts/observe/docker-forced-command`'s pattern.
#
# ## Verbs (SRD §6.4 — this is the final grammar; every verb the role is
# granted is enabled)
#
#   uptime  (no arguments)
#             -> cat /proc/uptime /proc/loadavg
#   os      (no arguments)
#             -> cat /etc/os-release
#   system  (no arguments)
#             -> systemctl is-system-running
#             Its exit status is never inspected here: a degraded system
#             answers with output and a non-zero exit, and both reach the
#             caller unchanged through `exec` (SRD §6.4). This script never
#             interprets that exit code as its own.
#   failed  (no arguments)
#             -> systemctl list-units --state=failed --no-legend --plain --no-pager
#   unit    <unit>  (exactly one argument, a unit name)
#             -> systemctl show <unit> --no-pager --property=Id,LoadState,ActiveState,SubState,Result,NRestarts,ActiveEnterTimestamp,ExecMainStatus
#   journal since=<N>s lines=<M>  (both required, M <= 500)
#           [unit=<unit>] [priority=<0-7>]  (both optional)
#             -> journalctl --no-pager --output=short-iso --lines=<M> --since=-<N>s [--unit=<unit>] [--priority=<P>]
#   kernel  since=<N>s lines=<M>  (both required, M <= 500; no other key)
#             -> journalctl --no-pager --dmesg --output=short-iso --lines=<M> --since=-<N>s
#   disk    (no arguments)
#             -> timeout 20 df -P -k
#   memory  (no arguments)
#             -> cat /proc/meminfo
#
# Every other verb — `shutdown`, `reboot`, `poweroff`, `halt`, any
# `systemctl` verb other than the two above (`start`, `stop`, `restart`,
# `reload`, `enable`, `disable`, `mask`, `kill`, `isolate`, `daemon-reload`,
# `set-property`, ...), any `journalctl` flag other than the closed set
# `journal`/`kernel` build below (`--vacuum-*`, `--rotate`, `--flush`,
# `--sync`, `--root`, `--file`, `--image`, `--directory`, ...), `kill`, any
# package manager, `sudo`, and any free-form path read — exits 77 naming the
# verb (or, for a bad `journal`/`kernel` argument, the verb plus a grammar
# reason) and runs nothing at all (SRD §6.4). A `unit` sub-verb such as
# `unit restart nginx.service` (two arguments after `unit`) is refused on the
# argument count before any grammar check runs, the same as task 5.1 left it.
#
# ## The unit-name grammar (SRD §6.3, tightened)
#
# SRD §6.3's class for a unit name is `[a-zA-Z0-9@._:-]+`. This script adds
# two tightenings, both stated here because they are this implementation's
# choice, not the SRD's:
#
#   1. The FIRST character must be `[a-zA-Z0-9]`, narrower than the rest of
#      the class. A leading '-' would otherwise reach `systemctl show` as an
#      option rather than as the unit-name operand (the same reasoning
#      `docker-forced-command`'s name grammar applies to a container name).
#   2. The length is capped at 255 bytes, so one argument cannot grow the
#      argv without bound.
#
# `journal`'s optional `unit=<unit>` reuses this exact grammar and cap.
#
# ## The `journal`/`kernel` argument grammar (SRD §6.4, tightened)
#
# Both verbs take zero or more `key=value` tokens, in ANY order. Every
# tightening below is this implementation's choice, stated here because the
# SRD leaves the exact grammar to the implementation:
#
#   1. A token that does not contain '=' at all, a token whose key (the text
#      before the first '=') is not one this verb recognises, or a key given
#      more than once — each is refused outright, before any other check
#      runs. This is a case-pattern dispatch on the WHOLE token
#      (`since=*`, `lines=*`, ...), not a split-then-validate on the key
#      substring, so an unrecognised or malformed token is never echoed
#      anywhere: the refusal reason is always a fixed string (see the header
#      above on why an unvalidated byte is never repeated back). This is
#      also what makes a `--vacuum-time=1s`-shaped token refused as an
#      unrecognised key rather than reaching `journalctl`'s argv: nothing
#      here treats a leading `--` specially, or appends an unmatched token
#      to the target command's argv — every token must match one of the
#      named `key=*` patterns to contribute anything at all.
#   2. `since=<N>s`: `N` is 1 to 9 ASCII digits, first digit always `1`-`9`
#      — no leading zero, and the lone digit `0` is refused too, not
#      treated as a length-1 exception, so `since=0s` is refused for both
#      `journal` and `kernel`: a zero-second lookback returns nothing, and
#      an empty result reads like "nothing happened" when nothing was
#      looked at, the reasoning `docker-forced-command` gives for refusing
#      its own `since=0s`. Immediately followed by the literal letter `s` — nothing
#      else. No shell arithmetic (`$(( ))`) ever touches `N`: an expression
#      like `$((08))` would misread a leading zero as an octal digit, so
#      every check here is a character class or a length compare
#      (`${#value}`), never a numeric one.
#   3. `lines=<M>`: `M` is ASCII digits only, no leading zero (so `M` is
#      never `0` either — `lines=0` is refused, `lines=00` too), and its
#      value must be 1 to 500 inclusive. The upper bound is enforced by
#      CASE-PATTERN matching against a 3-digit candidate (`[1-4][0-9][0-9]`
#      or the literal `500`), the same "compare digit strings, never
#      `$(( ))`" reasoning as `N` above — not `[ "$M" -le 500 ]`, even
#      though POSIX `test`'s own numeric comparison would read a
#      leading-zero digit string as decimal rather than octal (as
#      `docker-forced-command` notes of its own, more permissive `tail=`):
#      this script's `M` grammar refuses every leading zero before any
#      numeric question could arise, so no numeric operator is needed or
#      used.
#   4. `priority=<P>` (`journal` only): `P` is exactly one digit `0`-`7` —
#      the syslog priority range `journalctl --priority` also accepts a
#      symbolic name for, but this credential's grammar takes only the
#      digit.
#   5. `unit=<unit>` (`journal` only): the unit-name grammar above, unchanged.
#   6. `kernel` does not accept `unit=` or `priority=` at all: either key,
#      for `kernel`, is refused exactly like any other key `kernel` does not
#      recognise (choice 1), not with a bespoke message — `kernel` reads the
#      dmesg ring buffer, which has no per-unit or per-priority journal
#      fields to filter on the way `journal` does.
#   7. The SINCE SPELLING `--since=-<N>s` is MEASURED, not chosen here:
#      `test/fixtures/observe/vm-tool-shapes.json` -> `.since.chosen`,
#      confirmed to parse on both the oldest and the current target systemd
#      this project tracks (systemd 239 and systemd 255) and to actually
#      bound the query window (`.since.bound`). A re-measurement that picks
#      a different spelling is a deliberate edit to the literal `s` below,
#      not a guess.
#
# ## Exit codes
#
#   77  refused: an unrecognised verb, a missing or malformed
#       SSH_ORIGINAL_COMMAND, or an argument that fails its grammar. Matches
#       `docker-forced-command`'s convention, so an operator reads one code
#       for "not authorised" across the fleet.
#   127 the target command is not on PATH: the shell's own status when the
#       final `exec` finds nothing to run.
#   otherwise  the target command's own exit status, via `exec`: this script
#       never inspects or reinterprets it, and its stdout/stderr are never
#       touched either.
#
# Nothing here is ever `eval`ed, and no message interpolates a value that has
# not already passed one of the character classes above.

set -u
# Globbing off for the whole script, before the one unquoted re-split below
# (the SSH_ORIGINAL_COMMAND re-split). Without it a token of `*` would expand
# against this process's working directory instead of staying the one word
# it is (the lesson `docker-forced-command` and `docker/observe-ssh` both
# carry).
set -f

# IFS is pinned to the POSIX default (space, tab, newline) as defence in
# depth. Nothing depends on it: the re-split below sets its own IFS, and no
# unquoted expansion after that holds anything but a single grammar-checked
# word. The newline is written literally, because command substitution
# strips trailing newlines and `$(printf '\n')` would lose it.
POSIX_IFS="$(printf ' \t')
"
IFS="${POSIX_IFS}"

LOWER=abcdefghijklmnopqrstuvwxyz
UPPER=ABCDEFGHIJKLMNOPQRSTUVWXYZ
DIGIT=0123456789
ALNUM="${LOWER}${UPPER}${DIGIT}"

# SRD §6.3's unit-name class, plus the two tightenings the header documents.
# The trailing '-' is literal in every bracket expression built from this.
UNIT_CHARS="${ALNUM}@._:-"
UNIT_MAX=255

# $1 names the verb this refusal is about, or one of the two fixed
# placeholders below when there is none yet — never a raw, unvalidated byte
# string (see the header). $2 is the reason, also never interpolating an
# unvalidated value.
refuse() {
  printf 'vm-forced-command: refused "%s": %s\n' "$1" "$2" >&2
  exit 77
}

# True when $1 is non-empty and every character of it is in the set $2.
# A '-' in a set must come last, where a bracket expression reads it literally.
only_chars() {
  [ -n "$1" ] || return 1
  case $1 in
    *[!$2]*) return 1 ;;
  esac
  return 0
}

# True when the first character of $1 is in the set $2.
first_in() {
  case $1 in
    [$2]*) return 0 ;;
  esac
  return 1
}

is_verb() {
  only_chars "$1" "${LOWER}${DIGIT}-" && first_in "$1" "${LOWER}" && [ "${#1}" -le 32 ]
}

# The unit-name grammar: SRD §6.3's class, first character narrowed to
# alnum, length capped at 255 bytes (both tightenings, header explains why).
is_unit() {
  only_chars "$1" "${UNIT_CHARS}" && first_in "$1" "${ALNUM}" && [ "${#1}" -le "${UNIT_MAX}" ]
}

# `since=<N>s`'s `N`: decimal digits only, 1 to 9 of them, first digit
# always `1`-`9` — a lone `0` is refused, not treated as a length-1
# exception (header choice 2). Never `$(( ))`: the digit-count bound and
# the leading-zero check are both a character class or a length compare,
# nothing numeric.
is_since_n() {
  only_chars "$1" "${DIGIT}" || return 1
  case ${#1} in
    1 | 2 | 3 | 4 | 5 | 6 | 7 | 8 | 9) first_in "$1" "123456789" ;;
    *) return 1 ;;
  esac
}

# `lines=<M>`: decimal digits only, no leading zero (so never `0` either),
# value 1 to 500 inclusive (header choice 3). The upper bound is a CASE
# pattern against a 3-digit candidate, not a numeric comparison: a leading
# `1`-`4` is always under 500 regardless of the other two digits, and the
# one 3-digit exception at the boundary is matched literally.
is_lines() {
  only_chars "$1" "${DIGIT}" || return 1
  first_in "$1" "123456789" || return 1
  case ${#1} in
    1 | 2) return 0 ;;
    3)
      case $1 in
        [1-4][0-9][0-9]) return 0 ;;
        500) return 0 ;;
        *) return 1 ;;
      esac
      ;;
    *) return 1 ;;
  esac
}

# `priority=<P>` (`journal` only): exactly one digit `0`-`7` (header choice
# 4). A case pattern of a single bracket expression matches exactly one
# character, so a longer value (e.g. "37") is refused by construction.
is_priority() {
  case $1 in
    [01234567]) return 0 ;;
    *) return 1 ;;
  esac
}

# Parses the `key=value` arguments common to `journal` and `kernel` (header
# section on their grammar) into the globals since_val, lines_val, unit_val,
# priority_val (the raw text after each key's '=', ungrammar-checked until
# after the loop) and seen_since/seen_lines/seen_unit/seen_priority (0 or
# 1). Reads the global `verb` to name the refusal and to tell `journal` from
# `kernel` (`kernel` does not recognise `unit=` or `priority=` at all —
# header choice 6). Refuses immediately on: a token with no recognised
# key, a key repeated, or (for `kernel`) `unit=`/`priority=` at all; after
# the loop, on a missing `since=` or `lines=`, then on either value failing
# its own grammar. Every refusal reason here is a fixed string — never the
# token itself — because a case pattern selecting a branch does not prove
# the token's bytes are safe to print (header choice 1).
parse_journal_kernel_args() {
  since_val=
  lines_val=
  unit_val=
  priority_val=
  seen_since=0
  seen_lines=0
  seen_unit=0
  seen_priority=0
  for arg in "$@"; do
    case ${arg} in
      since=*)
        [ "${seen_since}" -eq 0 ] || refuse "${verb}" "since= may be given only once"
        since_val=${arg#since=}
        seen_since=1
        ;;
      lines=*)
        [ "${seen_lines}" -eq 0 ] || refuse "${verb}" "lines= may be given only once"
        lines_val=${arg#lines=}
        seen_lines=1
        ;;
      unit=*)
        [ "${verb}" = "journal" ] || refuse "${verb}" "unrecognised argument key"
        [ "${seen_unit}" -eq 0 ] || refuse "${verb}" "unit= may be given only once"
        unit_val=${arg#unit=}
        seen_unit=1
        ;;
      priority=*)
        [ "${verb}" = "journal" ] || refuse "${verb}" "unrecognised argument key"
        [ "${seen_priority}" -eq 0 ] || refuse "${verb}" "priority= may be given only once"
        priority_val=${arg#priority=}
        seen_priority=1
        ;;
      *=*)
        refuse "${verb}" "unrecognised argument key"
        ;;
      *)
        refuse "${verb}" "every argument must be key=value"
        ;;
    esac
  done
  [ "${seen_since}" -eq 1 ] || refuse "${verb}" "since=<N>s is required"
  [ "${seen_lines}" -eq 1 ] || refuse "${verb}" "lines=<M> is required"
  case ${since_val} in
    *s) since_n=${since_val%s} ;;
    *) refuse "${verb}" "a since= value must be [1-9][0-9]{0,8} digits, no leading zero, followed by 's'" ;;
  esac
  is_since_n "${since_n}" ||
    refuse "${verb}" "a since= value must be [1-9][0-9]{0,8} digits, no leading zero, followed by 's'"
  is_lines "${lines_val}" ||
    refuse "${verb}" "a lines= value must be 1-500, decimal digits only, no leading zero"
  if [ "${seen_unit}" -eq 1 ]; then
    is_unit "${unit_val}" ||
      refuse "${verb}" "a unit name must match ^[a-zA-Z0-9][a-zA-Z0-9@._:-]*\$, max ${UNIT_MAX} bytes"
  fi
  if [ "${seen_priority}" -eq 1 ]; then
    is_priority "${priority_val}" || refuse "${verb}" "a priority= value must be exactly one digit 0-7"
  fi
}

# --- read SSH_ORIGINAL_COMMAND ------------------------------------------------

original=${SSH_ORIGINAL_COMMAND:-}
[ -n "${original}" ] || refuse "(no verb)" "SSH_ORIGINAL_COMMAND is not set or is empty"

# Re-split on whitespace, globbing off. ssh joins the client's argv with
# spaces on the way over, so word boundaries are lost and must be rebuilt
# here. Splitting on tab as well as space is defence in depth for a caller
# that skipped the worker-side wrapper. Deliberately excludes newline, even
# though IFS is pinned to include one above: an embedded newline inside one
# token must stay inside that token, so the grammar below refuses it, rather
# than silently becoming a token boundary that could split one hostile token
# into two grammar-passing ones.
tab=$(printf '\t')
IFS=" ${tab}"
# shellcheck disable=SC2086 # unquoted on purpose: this is the re-split.
set -- ${original}
# Back to the pinned constant, not an inherited value (defence in depth, as
# above).
IFS="${POSIX_IFS}"

[ "$#" -ge 1 ] || refuse "(no verb)" "SSH_ORIGINAL_COMMAND held only whitespace"

verb=$1
shift

# Checked before the verb is ever echoed anywhere: only a value that has
# passed this class is safe to put in a message (the header explains why).
is_verb "${verb}" || refuse "(unrecognised)" "the verb is not [a-z][a-z0-9-]{0,31}"

case ${verb} in
  uptime)
    [ "$#" -eq 0 ] || refuse "${verb}" "uptime takes no arguments; got $#"
    exec cat /proc/uptime /proc/loadavg
    ;;
  os)
    [ "$#" -eq 0 ] || refuse "${verb}" "os takes no arguments; got $#"
    exec cat /etc/os-release
    ;;
  system)
    [ "$#" -eq 0 ] || refuse "${verb}" "system takes no arguments; got $#"
    exec systemctl is-system-running
    ;;
  failed)
    [ "$#" -eq 0 ] || refuse "${verb}" "failed takes no arguments; got $#"
    exec systemctl list-units --state=failed --no-legend --plain --no-pager
    ;;
  unit)
    [ "$#" -eq 1 ] || refuse "${verb}" "unit takes exactly one argument, a unit name; got $#"
    unit_name=$1
    is_unit "${unit_name}" ||
      refuse "${verb}" "a unit name must match ^[a-zA-Z0-9][a-zA-Z0-9@._:-]*\$, max ${UNIT_MAX} bytes"
    exec systemctl show "${unit_name}" --no-pager --property=Id,LoadState,ActiveState,SubState,Result,NRestarts,ActiveEnterTimestamp,ExecMainStatus
    ;;
  journal)
    parse_journal_kernel_args "$@"
    set -- journalctl --no-pager --output=short-iso "--lines=${lines_val}" "--since=-${since_n}s"
    [ "${seen_unit}" -eq 0 ] || set -- "$@" "--unit=${unit_val}"
    [ "${seen_priority}" -eq 0 ] || set -- "$@" "--priority=${priority_val}"
    exec "$@"
    ;;
  kernel)
    parse_journal_kernel_args "$@"
    exec journalctl --no-pager --dmesg --output=short-iso "--lines=${lines_val}" "--since=-${since_n}s"
    ;;
  disk)
    [ "$#" -eq 0 ] || refuse "${verb}" "disk takes no arguments; got $#"
    exec timeout 20 df -P -k
    ;;
  memory)
    [ "$#" -eq 0 ] || refuse "${verb}" "memory takes no arguments; got $#"
    exec cat /proc/meminfo
    ;;
  *)
    refuse "${verb}" "not a recognised verb; recognised verbs are uptime, os, system, failed, unit, journal, kernel, disk and memory"
    ;;
esac
