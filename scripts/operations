#!/usr/bin/env bun
/**
 * `scripts/operations` — open the standing three-pane operations console.
 *
 *   ./scripts/operations                       # ticketing worker tick-1
 *   ./scripts/operations --workers tick-1,sre-1
 *   ./scripts/operations --dry-run             # print the plan, touch nothing
 *
 * Panes, left to right: a ticketing agent you hand work to with
 * `pifleet dispatch`, a live `pifleet status --watch`, and a git poll loop over
 * THE DIRECTORY YOU RAN THIS FROM.
 *
 * Running it twice is safe and is the expected way to get back to the console:
 * an `operations` workspace that already exists is selected, not rebuilt. See
 * `src/backends/cmux/operations.ts` for why rebuilding would be destruction.
 *
 * Only I/O lives here — argv parsing, the process exit, and the printing. The
 * decisions are in `src/operations/plan.ts` and `src/backends/cmux/operations.ts`,
 * where `test/unit/operations-plan.test.ts` and
 * `test/unit/operations-workspace.test.ts` re-check them on every run.
 */

import { dirname, resolve } from "node:path";

import { CmuxClient } from "../src/backends/cmux/client.ts";
import { loadConfig, resolveWorker } from "../src/config/load.ts";
import { EXIT } from "../src/contracts.ts";
import {
  DEFAULT_OPERATIONS_WORKERS,
  OPERATIONS_WORKSPACE,
  operationsPanes,
} from "../src/backends/cmux/operations-plan.ts";
import {
  OPERATIONS_SPEC,
  cmuxReachable,
  ensureOperations,
  restartConsolePane,
} from "../src/backends/cmux/operations.ts";
import { runsHoldingAny } from "../src/run/status-runs.ts";

const USAGE = `Usage: scripts/operations [options]

  --workers <ids>   comma-separated pifleet workers for the agent panes
                    (default: obs-1,tick-1 — also the set --recreate scopes to)
  --backend <kind>  pifleet backend for pane 1 (default: headless)
  --config <path>   fleet.yaml for pane 1 (default: <repo>/fleet.yaml)
  --poll <seconds>  git pane refresh interval (default: 5)
  --dry-run         print the pane plan and exit without touching cmux
  --recreate        close an existing operations workspace and rebuild it
  --restart <title> respawn ONE pane by title, leaving the others running
  -h, --help        this message
`;

function flag(argv: string[], name: string): string | undefined {
  const i = argv.indexOf(name);
  if (i === -1) return undefined;
  const v = argv[i + 1];
  if (v === undefined || v.startsWith("--")) {
    throw new Error(`${name} needs a value`);
  }
  return v;
}

async function main(argv: string[]): Promise<number> {
  if (argv.includes("-h") || argv.includes("--help")) {
    process.stdout.write(USAGE);
    return EXIT.SUCCESS;
  }

  // `scripts/` sits directly under the repository root.
  const repoRoot = resolve(dirname(new URL(import.meta.url).pathname), "..");
  const watchDir = process.cwd();

  const workersFlag = flag(argv, "--workers");
  const pollFlag = flag(argv, "--poll");

  const opts = {
    repoRoot,
    watchDir,
    ...(workersFlag === undefined
      ? {}
      : { workers: workersFlag.split(",").map((w) => w.trim()).filter((w) => w !== "") }),
    ...(flag(argv, "--backend") === undefined ? {} : { backend: flag(argv, "--backend")! }),
    ...(flag(argv, "--config") === undefined ? {} : { configPath: flag(argv, "--config")! }),
    ...(pollFlag === undefined ? {} : { gitPollSeconds: Number(pollFlag) }),
  };

  /**
   * Does pane 1's agent want Pi's own interface?
   *
   * READ FROM THE CONFIG rather than asked for with a flag, because the answer
   * is already written down: a worker is `pane_mode: tui` or it is not, and
   * making the operator restate it on the command line is how the two get to
   * disagree. A tui worker with a log-tail pane shows nothing; an rpc worker
   * with `--attach-here` is refused by `up` (correctly — there would be no
   * TTY inside the container to attach to).
   *
   * Failure is NOT fatal and is not silent either. `--dry-run` must work with
   * no config at all, and a console that refuses to open because a fleet.yaml
   * moved is worse than one that opens with a log tail — but an operator who
   * expected a TUI needs to know why they got a viewer.
   */
  let tuiWorkers: string[] = [];
  try {
    const loaded = await loadConfig(opts.configPath ?? `${repoRoot}/fleet.yaml`);
    // EVERY console worker, not just the first. Each agent pane runs its own
    // `up` and attaches its own terminal, so each one's pane_mode has to be
    // resolved separately — a single answer taken from workers[0] would decide
    // one pane's mode from another pane's worker. That is not hypothetical:
    // this read a hardcoded "tick-1" while the plan had moved to obs-1, so the
    // console brought up obs-1 and rendered it as a log tail.
    //
    // DEFAULT_OPERATIONS_WORKERS, never a second literal: `operationsPanes`
    // falls back to that same list when `--workers` is absent.
    const set = opts.workers ?? DEFAULT_OPERATIONS_WORKERS;
    tuiWorkers = set.filter((w) => resolveWorker(loaded, w).paneMode === "tui");
  } catch (err) {
    process.stderr.write(
      `operations: could not read pane_mode from the config ` +
        `(${err instanceof Error ? err.message : String(err)}); the agent panes will tail their logs\n`,
    );
  }

  // Built before the cmux probe on purpose: a bad `--workers` or `--poll` is
  // an argv mistake, and diagnosing it must not depend on whether the GUI
  // happens to be running.
  const panes = operationsPanes({ ...opts, tuiWorkers });

  if (argv.includes("--dry-run")) {
    process.stdout.write(`workspace: ${OPERATIONS_WORKSPACE}\ncwd:       ${watchDir}\n\n`);
    for (const [i, p] of panes.entries()) {
      process.stdout.write(`pane ${i + 1} (${p.title}):\n  ${p.command}\n\n`);
    }
    return EXIT.SUCCESS;
  }

  /*
   * `--recreate` stops the run the OLD panes created, before the new ones make
   * another.
   *
   * Without this, `--recreate` leaks a run every time: the panes are torn down
   * but the containers they started keep running, unattached, until something
   * else stops them. Four accumulated in one session, one of them for ten
   * hours.
   *
   * The leak is not just untidy, it corrupts the new console. A run directory
   * outlives its run, so `status` keeps reporting the old run and `logs`
   * resolves "the most recent run" to whichever exists at the instant a pane
   * asks. With two runs in flight, the ticketing pane latched onto the older
   * one and tailed a log file that had stopped growing — a pane that reads as
   * a hung worker while the observer beside it is healthy.
   *
   * Only on `--recreate`. Adoption must not touch a running fleet: the whole
   * point of the default path is that a second `operations` changes nothing.
   */
  if (argv.includes("--recreate")) {
    /*
     * EVERY run of THIS console's workers — not the newest, and not every run
     * on the machine.
     *
     * Both halves of that sentence were learned the hard way, in that order.
     * Stopping only the most recent left the other attended pane's containers
     * behind and closed half the leak; the fix for that was a bare sweep of
     * `status --all`, and the sweep had no idea whose runs it was reading.
     *
     * MEASURED 2026-09-02, twice in one session: rebuilding this console
     * printed six `stopping run …` lines — its own two, and the FOUR seats of
     * the `development` console, which had nothing to do with it. Those four
     * panes were left attached to runs that no longer existed. `scripts/
     * development` already had the answer and says so in its own comment —
     * *"the operations console's runs are somebody else's and must survive a
     * development rebuild"* — so the scoping landed in one launcher and not
     * the other, and the launcher that missed it is the one that sweeps
     * widest.
     *
     * `runsHoldingAny` rather than a second copy of the predicate, for the
     * reason this repo keeps rediscovering: two spellings of one rule are two
     * rules. It also PARSES the status document instead of scraping
     * `/"run_id":"([^"]+)"/g` out of it, which is what stood here — a regex
     * that matches the key wherever it appears, including nested inside a
     * record that is not a run, and which cannot see the `workers` array it
     * would now have to consult anyway. An unreadable status stops nothing,
     * which is the correct blast radius for a launcher.
     */
    const mine = new Set(opts.workers ?? DEFAULT_OPERATIONS_WORKERS);
    const json = await runOutput(repoRoot, ["status", "--all", "--json"]);
    for (const runId of runsHoldingAny(json, mine)) {
      process.stderr.write(`operations: stopping run ${runId} before rebuilding\n`);
      // Best effort. A run that cannot be stopped is worth a line, not a
      // refusal to open the console the operator asked for.
      await runOutput(repoRoot, ["down", "--run", runId]);
    }
  }

  const client = new CmuxClient();
  if (!(await cmuxReachable(client))) {
    process.stderr.write(
      "operations: no cmux is listening on ~/.local/state/cmux/cmux.sock.\n" +
        "Start the cmux app, then run this again.\n",
    );
    return EXIT.BACKEND_UNAVAILABLE;
  }

  // Adoption is the default and stays it — a second `operations` must not stack
  // a duplicate console on the one the operator is working in. `--recreate` is
  // for the case adoption cannot reach: the workspace TITLE is what identifies
  // a console, so one whose panes have died, or whose commands were built by an
  // older version of this script, is adopted forever and reported as "already
  // in place — changed nothing", which is true and useless.
  /*
   * `--restart <title>` — one pane, and nothing else touched.
   *
   * TITLE, not worker id, because this console's panes are not all workers:
   * `fleet-status` and the monitor are panes too, and a wedged watch pane is
   * as worth restarting as a wedged agent. `restartConsolePane` resolves
   * against the PLAN, so the set of legal values is whatever this console
   * builds, and a title that is not one of them is refused with the list.
   *
   * The run teardown is scoped to a run actually holding that id, so naming a
   * watch pane stops nothing and simply respawns it.
   */
  const restartFlag = flag(argv, "--restart");
  if (restartFlag !== undefined) {
    const json = await runOutput(repoRoot, ["status", "--all", "--json"]);
    for (const runId of runsHoldingAny(json, new Set([restartFlag]))) {
      process.stderr.write(`operations: stopping run ${runId} before restarting ${restartFlag}\n`);
      await runOutput(repoRoot, ["down", "--run", runId]);
    }
    const r = await restartConsolePane(client, OPERATIONS_SPEC, { ...opts, tuiWorkers }, restartFlag);
    process.stdout.write(
      `operations: respawned the ${restartFlag} pane (surface ${r.surfaceId}) ` +
        `in workspace ${r.workspaceId}; the other panes were not touched\n`,
    );
    return EXIT.SUCCESS;
  }

  const recreate = argv.includes("--recreate");
  const result = await ensureOperations(client, { ...opts, tuiWorkers }, recreate);
  process.stdout.write(
    result.created
      ? `operations: ${recreate ? "rebuilt" : "created"} workspace ${result.workspaceId} ` +
        `with ${panes.length} panes\n`
      : `operations: workspace ${result.workspaceId} is already in place — selected it, changed ` +
        `nothing (use --recreate to rebuild its panes)\n`,
  );
  return EXIT.SUCCESS;
}

try {
  process.exit(await main(process.argv.slice(2)));
} catch (err) {
  // The plan module already prefixes its refusals with `operations:`; adding a
  // second one made every input error read `operations: operations: ...`.
  const msg = err instanceof Error ? err.message : String(err);
  process.stderr.write(`${msg.startsWith("operations:") ? msg : `operations: ${msg}`}\n`);
  process.exit(EXIT.USAGE);
}

/** Run a `pifleet` subcommand and return its stdout, swallowing failure. */
async function runOutput(repoRoot: string, args: readonly string[]): Promise<string> {
  try {
    const proc = Bun.spawn(["bun", "run", `${repoRoot}/src/cli/index.ts`, ...args], {
      stdout: "pipe",
      stderr: "ignore",
    });
    const out = await new Response(proc.stdout).text();
    await proc.exited;
    return out;
  } catch {
    return "";
  }
}
